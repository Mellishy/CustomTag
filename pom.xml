<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mellishy</groupId>
    <artifactId>CustomTag</artifactId>
    <version>4.0.0</version>
    <packaging>jar</packaging>

    <name>CustomTag</name>
    <description>Custom player tag platform for Paper servers and networks: token economy with a full transaction ledger, global request queue with staff locking and priorities, multi-stage validation pipeline, optional AI moderation, Discord/Telegram/webhook integrations, audit trail, Redis cross-server sync, roles with granular permissions, a public developer API, GUI-driven creation and pluggable MySQL/MongoDB/YAML storage.</description>
    <url>https://github.com/Mellishy/MellishyCustomTag</url>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Update this to match the exact Paper build you deploy on -->
        <paper.version>1.21.1-R0.1-SNAPSHOT</paper.version>
        <mysql.version>8.4.0</mysql.version>
        <mongodb.version>5.1.1</mongodb.version>
        <hikaricp.version>5.1.0</hikaricp.version>
        <jedis.version>5.1.3</jedis.version>
        <shade.plugin.version>3.5.3</shade.plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <!-- storage.type: mysql - connection pooling. slf4j-api is excluded because Paper already
             provides an slf4j implementation on the runtime classpath (since 1.19) - shipping a
             second copy risks a version clash with whatever Paper/other plugins already loaded -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- storage.type: mysql - only pulled/shaded into the final jar if you actually use it,
             but harmless either way since it's never loaded unless storage.type is set to mysql -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- storage.type: mongodb -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>${mongodb.version}</version>
            <scope>compile</scope>
        </dependency>
        <!-- network sync-backend: redis (cross-server pub/sub). Only connects when
             network/settings.yml sets sync-backend: redis. gson/json/slf4j are excluded because
             we only use plain pub/sub (none of Jedis' JSON module is touched) and Paper already
             ships gson + an slf4j implementation on the runtime classpath -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>${jedis.version}</version>
            <scope>compile</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.code.gson</groupId>
                    <artifactId>gson</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.json</groupId>
                    <artifactId>json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Test-only. Scoped to Bukkit-free collaborators and contracts (TokenService,
             RequestManager, PlayerData, TagJson, SyncEvent parsing, StorageBackend contract via
             an in-memory stand-in). TagService / GUIs / Listeners need a live Paper server and are
             covered by TagLifecycleInvariantsTest driving the same collaborators TagService mutates,
             plus in-game QA. See src/test/java. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- bundles the MySQL/MongoDB drivers straight into the plugin jar (relocated under
                 com.mellishy.customtag.libs.* so they can never clash with another plugin on the
                 same server shipping a different version of the same libraries) so server owners
                 don't have to install anything extra to use those storage backends -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>com.mysql</pattern>
                                    <shadedPattern>com.mellishy.customtag.libs.mysql</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.mongodb</pattern>
                                    <shadedPattern>com.mellishy.customtag.libs.mongodb</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bson</pattern>
                                    <shadedPattern>com.mellishy.customtag.libs.bson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>com.mellishy.customtag.libs.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>redis.clients</pattern>
                                    <shadedPattern>com.mellishy.customtag.libs.jedis</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.pool2</pattern>
                                    <shadedPattern>com.mellishy.customtag.libs.commonspool2</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
